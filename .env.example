# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=online_shop_perfume_dev
TEST_DB_NAME=online_shop_perfume_test

# Application environment: development, testing, or production
APP_ENV=development

# Flask Secret Key for session signing and CSRF protection
# In development: can be set locally or left blank to auto-generate an ephemeral key
# In production: MUST be set to a cryptographically secure random string (minimum 16 chars)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change_this_to_a_random_string_in_production
FLASK_DEBUG=1

# Optional SSL CA certificate path for remote managed databases (e.g., Aiven, AWS RDS, GCP Cloud SQL)
# Required in production when connecting to a remote DB_HOST
# DB_SSL_CA=/path/to/ca.pem
